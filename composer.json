{
    "name": "mindflex/matchmaking",
    "description": "Mindflex tutor and student matchmaking system with an internal admin dashboard.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "ext-json": "*",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1",
        "laravel/pint": "^1.20"
    },
    "autoload": {
        "psr-4": {
            "Mindflex\\": "src/"
        },
        "files": [
            "src/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Mindflex\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "setup": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@composer install",
            "@fresh"
        ],
        "migrate": "@php bin/console migrate",
        "seed": "@php bin/console seed",
        "fresh": "@php bin/console fresh",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@php -S localhost:8000 -t public"
        ],
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=512M",
        "lint": "pint --test",
        "format": "pint",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "setup": "Copy .env, install dependencies, then build and seed the database.",
        "serve": "Start the dashboard on http://localhost:8000.",
        "migrate": "Run pending database migrations.",
        "seed": "Insert demo data.",
        "fresh": "Drop the database, migrate, then seed.",
        "test": "Run the PHPUnit suite.",
        "analyse": "Run PHPStan static analysis at level 8.",
        "lint": "Check code style without changing files.",
        "format": "Fix code style.",
        "check": "Run lint, static analysis, and tests."
    }
}
