# Salin file ini menjadi .env lalu sesuaikan.
# Nilai di bawah ini aman untuk pengembangan lokal saja.

APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_CURRENCY=USD

# Path database relatif terhadap root proyek. Wajib di luar folder public/.
DB_PATH=storage/mindflex.db

# Login dashboard. Password demo: mindflex-admin
# Buat hash baru dengan: php bin/console hash:password "password-anda"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH='$2y$10$2RtXXjVeIM/MaUREcqWbue45IX5AdCkPISJ8tcizro3kMrRy6Qn.S'

# Dipakai endpoint tulis di api_legacy.php lewat header X-Api-Key.
API_KEY=local-development-api-key

# Batas rasio biaya mingguan terhadap budget student sebelum sistem menolak match.
MATCHING_BUDGET_TOLERANCE=1.0
